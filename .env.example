# StudyMate AI - Environment Variables Template
# Copy this file to .env and fill in the values.
# DO NOT COMMIT YOUR ACTUAL .ENV FILE TO GITHUB.

FLASK_SECRET_KEY=your_generated_hex_key_here
DATABASE_URL=postgres://user:password@endpoint.neon.tech/neondb?sslmode=require

# AI API Keys
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Email Configuration (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password_here
